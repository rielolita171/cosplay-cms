# ==============================================================================
# cosplay-cms environment template
#
#   cp .env.example .env    then fill in the real values.
#
# ONLY variables that are actually read by the application appear here. Several
# variables that look plausible are deliberately ABSENT because no line of code
# reads them: DATABASE_URL, UPLOAD_DIR, IMPORT_DIR and SESSION_SECRET. Setting
# them would create a false impression that they configure something.
# (SESSION_SECRET in particular is a real secret sitting in the live .env that
# the app ignores — it can be removed from there.)
#
# JWT_SECRET used to be here and is now gone: this app has no login, so there is
# nothing to sign. If your live .env still has a JWT_SECRET line, it is inert and
# can be deleted. The only credential left in this file is API_KEY, and that
# guards the n8n notification endpoints only — not the CMS itself.
#
# Everything is a real dotenv file: no ${VAR} interpolation, which dotenv does
# not implement. If you copy this file verbatim, fix every value marked TODO.
# ==============================================================================


# ------------------------------------------------------------------------------
# PORT — the port the server binds INSIDE the container.
# ------------------------------------------------------------------------------
# src/server.js:12  ->  const PORT = process.env.PORT || 4001
# src/server.js:453 ->  server.listen(PORT, '0.0.0.0')
#
# Leave this at 4001. The host-side port is remapped by compose
# ("${CMS_PORT:-4001}:4001") because the n8n workflow JSON hardcodes 4001, so
# changing the host port silently breaks that integration while the container
# keeps working — the worst kind of failure.
PORT=4001


# ------------------------------------------------------------------------------
# NODE_ENV — switches on production-only behaviour.
# ------------------------------------------------------------------------------
# Set this to production for any real deployment.
NODE_ENV=production


# ------------------------------------------------------------------------------
# DATABASE_PATH — where the SQLite file lives.
# ------------------------------------------------------------------------------
# src/services/db.js:34 -> const DB_FILE = process.env.DATABASE_PATH || 'data/db/cms.db'
#
# This default is RELATIVE and resolved against process.cwd(), deliberately, so
# scripts/test_phase5.js can isolate a run by changing directory. Inside the
# container WORKDIR is /app, so the relative form and the absolute form below
# point at exactly the same file. The absolute path is spelled out here because
# it is what the entrypoint resolves, and being explicit keeps the two in
# agreement rather than merely coinciding.
#
# This file must sit on the /app/data volume, or the database is lost on the next
# container replacement.
DATABASE_PATH=/app/data/db/cms.db


# ------------------------------------------------------------------------------
# API_KEY — authenticates server-to-server calls (n8n, cron) to the notification
#            endpoints, via the X-CMS-API-KEY header.
#
# THIS IS NOT LOGIN. It is the only remaining credential in the app, and it does
# not protect the CMS: the dashboard and every /api endpoint for costumes,
# props, lenses, brands, fandoms and images are reachable with no credentials at
# all. The network boundary is what protects those — see DOCKER.md before
# exposing this service beyond your own LAN.
# ------------------------------------------------------------------------------
# src/middleware/apiKeyAuth.js — compared in constant time against a SHA-256
# digest, so the comparison itself does not leak the key by timing.
#
# FAIL-CLOSED: if this is unset, requireApiKey() returns 403 for every caller.
# There is no default and no bypass.
#
# TWO TRAPS IN isValidApiKey():
#   1. A key containing the literal substring 'your_', 'here', or '$(' is
#      treated as an unfilled placeholder and REJECTED. Do not use a key like
#      "your_n8n_key_here" — it will be refused even if the client sends the
#      identical string.
#   2. The value is .trim()ed on both sides, so a trailing newline is harmless
#      but a leading space inside a quoted value is not.
#
# Must be at least 16 characters. Generate with: openssl rand -hex 24
API_KEY=replace_me_with_a_long_random_string_at_least_16_chars


# ------------------------------------------------------------------------------
# CORS_ORIGIN — comma-separated list of browser origins allowed to call the API.
# ------------------------------------------------------------------------------
# The dashboard SPA is served by this same Express process, so the same-origin
# default needs no entry. Set this only when the UI is hosted on a different
# domain than the API. The wildcard form disables credentials and is rejected by
# browsers for authenticated requests, so list exact origins instead.
#
# Example: CORS_ORIGIN=https://cms.example.com,https://admin.example.com
# Leave empty to keep the same-origin default.
CORS_ORIGIN=


# ------------------------------------------------------------------------------
# CMS_ALLOW_ANY_ORIGIN — ESCAPE HATCH. Accept every browser origin. Default: off.
# ------------------------------------------------------------------------------
# Leave this UNSET. The CORS allowlist above is the security boundary for an app
# that has NO login: with it enforced, a page in any other browser on the same
# machine cannot read or write the collection, because every cross-origin request
# is refused. That is the default on every platform, including the desktop app.
#
# Setting this to 1/true/yes/on disables that protection entirely, INCLUDING for
# the opaque origin "null" that file://, data: and sandboxed iframes send. On a
# LAN-exposed container that means any website the operator visits can read AND
# write the whole database. Only set it for the desktop app, and only as a
# temporary measure while diagnosing an origin problem.
#
# Values that are not recognised are IGNORED, not guessed at, so a typo fails
# safe and leaves the allowlist enforced.
#
# Related, and NOT for you to set in this file: CMS_SELF_ORIGIN is injected by the
# desktop app itself to mark its own origin as permanently allowed. Setting it
# here would make this container claim to be a desktop build, which changes how
# imported allowlists are reconciled. Leave it unset.
CMS_ALLOW_ANY_ORIGIN=


# ------------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN — optional. Enables Telegram alerts.
# ------------------------------------------------------------------------------
# src/services/telegramService.js. Strictly on-demand: it is called when a
# notification is triggered, never at boot, with a 5s timeout, and it never
# rejects — a broken Telegram integration cannot take the server down and cannot
# delay startup. The app boots fully offline with this empty.
#
# Obtain from @BotFather. Format: 123456789:AA... (leave the trailing part intact)
# Leave empty to disable Telegram entirely.
TELEGRAM_BOT_TOKEN=
