// Prisma Schema for Cosplay Management System
// SQLite database using file-based storage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MODEL - Handles authentication, OAuth, Telegram 2FA
// ============================================================================
model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String    @unique
  oauthProvider      String?   // google, github, etc.
  oauthId            String?   @unique
  telegramChatId     String?   @unique
  telegram2FAEnabled Boolean   @default(true)
  twoFactorSecret    String?   // TOTP secret (optional backup)
  twoFactorExpiry    DateTime?
  recoveryCodeHash   String?   // Hashed break-glass recovery key
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ============================================================================
// BRAND MODEL - Managed reference list (feeds the brand dropdown)
//
// NOTE: this file is currently VESTIGIAL — no code reads it, and the live
// schema is init_db.sql plus the idempotent migration in
// src/services/db.js:initSchema(). It is kept in sync for documentation.
//
// "Costume".brand holds the NAME of a Brand row, not its id. That is a SOFT
// reference, deliberately NOT a Prisma @relation: the existing 83 costumes
// already store a display string, so keeping it as a string means the
// migration rewrites nothing at all, and a deleted/renamed Brand can never
// leave a dangling id behind. Enforcement lives in src/routes/brands.js
// (a delete of a referenced brand is refused with 409).
//
// "nameLower" carries a case-folded copy of "name" so uniqueness is
// case-insensitive; SQLite enforces it with a UNIQUE index on that column,
// which is what the backfill's INSERT OR IGNORE keys off.
// ============================================================================
model Brand {
  id        String   @id @default(uuid())
  name      String
  nameLower String   @unique
  storeUrl  String?  // Optional online store; validated server-side to be http(s) only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// FANDOM MODEL - Managed reference list (feeds the fandom dropdown)
// Soft reference from "Costume".fandom, same reasoning as Brand above.
// ============================================================================
model Fandom {
  id        String   @id @default(uuid())
  name      String
  nameLower String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// COSTUME MODEL - Main inventory tracking with completion milestones
// ============================================================================
model Costume {
  id                 String        @id @default(uuid())
  fandom             String        // Anime series, game, etc. (soft ref to Fandom.name)
  character          String        // Character name
  brand              String?       // Maker/brand name (soft ref to Brand.name)
  // Free text on purpose, NOT an enum/CHECK: legacy rows may hold a bespoke
  // value ("One Size", a custom measurement) and a constraint would make them
  // unwritable. New/edited entries are validated against XS, S, M, L, XL, 2XL,
  // 3XL in src/routes/costumes.js:normalizeSize(), with an explicit `sizeOther`
  // escape hatch for anything bespoke.
  size               String?       // XS, S, M, L, XL, 2XL, 3XL — or a custom value
  isFullset          Boolean       @default(false)
  doneCostest        Boolean       @default(false)     // Competed at costest event
  doneEvent          Boolean       @default(false)     // Worn at formal event
  donePhotoSession   Boolean       @default(false)     // Professional photo session
  status             CostumeStatus @default(IN_POSSESSION)
  buyPrice           Float?
  sellPrice          Float?
  sellPriceMutual    Float?        // Mutual swap offer price
  notes              String?
  referenceUrl       String?
  imageUrls          String        @default("[]")     // JSON array of image URLs
  props              Prop[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

enum CostumeStatus {
  IN_POSSESSION
  ON_RENT
  TO_BE_SOLD
  WISHLIST
}

// ============================================================================
// PROP MODEL - Props, accessories, wigs linked to costumes
// ============================================================================
model Prop {
  id        String    @id @default(uuid())
  costumeId String?
  costume   Costume?  @relation(fields: [costumeId], references: [id], onDelete: SetNull)
  name      String    // e.g., "Raiden Shogun's Polearm"
  category  String?   // Weapon, Armor, Headpiece, Wig, Accessory, Shoes
  location  String?   // Storage location: "Box A - Hall Closet", "Shelf 2 - Bedroom"
  condition String?   // Mint, Minor Wear, Needs Repair, Damaged
  notes     String?
  imageUrls String?   @default("[]")    // JSON array
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ============================================================================
// CONTACT LENS MODEL - Colored/prescription lens inventory with expiry tracking
// ============================================================================
model ContactLens {
  id           String     @id @default(uuid())
  character    String?    // Character these lenses are for
  color        String     // Purple, Red, Blue, etc.
  brand        String?    // Sweety Spata, Pinkholic, etc.
  prescription String?    // Degree: -1.50, 0.00, +2.00
  purchaseDate DateTime?
  openedDate   DateTime?  // Date lens vial was first opened
  expiryDate   DateTime   // Factory expiration or calculated active expiry
  isOpened     Boolean    @default(false)
  status       LensStatus @default(UNOPENED)
  notes        String?
  imageUrl     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum LensStatus {
  UNOPENED      // Sealed, valid until factory expiration
  ACTIVE        // Currently open, within safe lifespan (12 months from open date)
  EXPIRING_SOON // Within 14-day warning threshold
  EXPIRED       // Past safe usage date
  DISPOSED      // Properly discarded
}
